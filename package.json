{
  "name": "godseye-holborn",
  "version": "1.1.0",
  "description": "Holborn-only surveillance intelligence dashboard — snapshot-only TfL camera monitoring and Police UK crime mapping",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:e2e-runtime": "node scripts/e2e/verify-playwright-runtime.mjs --required=chromium",
    "test:e2e": "npm run verify:e2e-runtime && playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "scan:secrets": "bash tests/no-secrets.sh",
    "deploy:aws": "bash deploy.sh",
    "deploy": "npm run deploy:aws"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "framer-motion": "^11.0.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@playwright/test": "^1.41.2",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@types/leaflet": "^1.9.8",
    "@types/node": "^20.11.19",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.2.2",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.3",
    "vitest": "^1.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MaverickHQ/godseye-holborn"
  },
  "keywords": [
    "cctv",
    "monitoring",
    "crime-mapping",
    "palantir",
    "aws",
    "cloudfront",
    "react"
  ],
  "author": "Maverick",
  "license": "MIT"
}
