# Environment Variables Example
# Copy this file to .env.local for local development

# =============================================================================
# PRODUCTION: API Proxy (use this in production)
# =============================================================================
# Set this to your deployed Lambda/API Gateway URL
# The proxy handles API keys server-side - no keys exposed to frontend
VITE_PROXY_BASE_URL=

# =============================================================================
# DEVELOPMENT: Direct API Keys (only used when VITE_PROXY_BASE_URL is empty)
# =============================================================================
# Get these from respective services for local development
VITE_TFL_API_KEY=

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Target area (defaults)
VITE_TARGET_LAT=51.5185
VITE_TARGET_LNG=-0.1065
VITE_TARGET_NAME=Holborn, London

# Animation setting (kept for legacy intro transitions)
VITE_ANIMATION_DURATION=7000

# Crime data settings
VITE_CRIME_RADIUS=1000
VITE_CRIME_DEFAULT_MONTH=2025-03

# Data polling intervals (minimum 60000ms = 60 seconds)
VITE_CRIME_POLL_INTERVAL_MS=60000
VITE_CAMERA_POLL_INTERVAL_MS=60000

# Optional: Map provider
# VITE_MAPBOX_TOKEN=your_mapbox_token_here
